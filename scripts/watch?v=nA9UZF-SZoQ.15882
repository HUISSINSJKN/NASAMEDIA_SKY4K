rue}},"targetId":"PAsearch_preview","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN","onShowCommands":[{"clickTrackingParams":"CBsQ040EGAQiEwj9jNGZtO2XAxVMEFcBHbgyM6bKAQS6ugtk","scrollToEngagementPanelCommand":{"targetId":"PAsearch_preview"}}],"identifier":{"tag":"PAsearch_preview"},"loggingDirectives":{"trackingParams":"CBsQ040EGAQiEwj9jNGZtO2XAxVMEFcBHbgyM6Y=","visibility":{"types":"12"}}}},{"engagementPanelSectionListRenderer":{"panelIdentifier":"engagement-panel-structured-description","content":{"structuredDescriptionContentRenderer":{"items":[{"videoTitleHeaderViewModel":{"videoTitle":{"content":"NASA Live: Official Stream of NASA TV's Media Channel"},"headerButton":{"buttonViewModel":{"iconName":"CLOSE","onTap":{"innertubeCommand":{"clickTrackingParams":"CBoQiPkBIhMI_YzRmbTtlwMVTBBXAR24MjOmygEEuroLZA==","hideEngagementPanelEndpoint":{"panelIdentifier":"engagement-panel-structured-description"}}},"accessibilityText":"Close","style":"BUTTON_VIEW_MODEL_STYLE_MONO","trackingParams":"CBoQiPkBIhMI_YzRmbTtlwMVTBBXAR24MjOm","type":"BUTTON_VIEW_MODEL_TYPE_TEXT","buttonSize":"BUTTON_VIEW_MODEL_SIZE_DEFAULT","loggingDirectives":{"trackingParams":"CBoQiPkBIhMI_YzRmbTtlwMVTBBXAR24MjOm","visibility":{"types":"12"}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CBkQ0f0TGAAiEwj9jNGZtO2XAxVMEFcBHbgyM6Y=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"NASA"},"views":{"simpleText":"25,057,318 views"},"publishDate":{"simpleText":"Streamed live on Feb 14, 2019"},"channelNavigationEndpoint":{"clickTrackingParams":"CBIQ040EGAUiEwj9jNGZtO2XAxVMEFcBHbgyM6bKAQS6ugtk","commandMetadata":{"webCommandMetadata":{"url":"/@NASA","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCLA_DiR1FfKNvjuUpBHmylQ","canonicalBaseUrl":"/@NASA"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/eIf5fNPcIcj9ig-wZBeq4stFy1lgjWTW1nLT5dYlFkHZprZ03QBiMcbpwNMB6XSBjrSFGtAGQg=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"UPDATE: Our 24/7 NASA TV media channel is being phased out as of Aug. 28, 2024. We will continue to stream live events and share new videos on our YouTube account—please subscribe to our channel to make sure you get the latest updates!\n\nWe'll also continue to stream live views from the International Space Station on this page. Visit NASA+ (https://plus.nasa.gov/) for more live events and original NASA shows.\n\n=========================================\n\nDirect from America's space program to YouTube, watch NASA TV live streaming here to get the latest from our exploration of the universe and learn how we discover our home planet.\n\nNASA TV airs a variety of regularly scheduled, pre-recorded educational and public relations programming 24 hours a day on its various channels. The network also provides an array of live programming, such as 24-hour coverage of missions, events (spacewalks, media interviews, educational broadcasts), press conferences and rocket launches.\n\nIn the United States, NASA Television's Public and Media channels are MPEG-2 digital C-band signals carried by DVB-S2/8PSK modulation on satellite Galaxy 37, transponder 15, at 127 degrees west longitude. Downlink frequency is 4009.00 MHz, horizontal polarization, with a data rate of 36.225 Mbps, symbol rate of 15.000 Msps, and 5/6 FEC. A Digital Video Broadcast (DVB-S2) compliant Integrated Receiver Decoder (IRD) is needed for reception.","commandRuns":[{"startIndex":342,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAUiEwj9jNGZtO2XAxVMEFcBHbgyM6ZIhM3J_MWM1YecAcoBBLq6C2Q=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=Q